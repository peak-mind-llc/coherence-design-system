// Declaration-only emit for /design-sync. The kit's React source is normally
// type-checked by desktop's tsconfig (see tsconfig.json's `exclude`), but the
// design-sync converter needs a real .d.ts tree to extract each component's
// props contract from. Emits alongside the sources, which is where the
// converter's types-root discovery looks (package.json `types` → src/).
// Output is gitignored; regenerate with:
//   npx tsc -p packages/cw-design-system-ts/tsconfig.dts.json
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false
  },
  "include": ["src/components", "src/lib", "src/hooks"],
  "exclude": ["**/*.stories.tsx"]
}
